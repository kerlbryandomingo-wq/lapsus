{
  "name": "lapsus",
  "productName": "Lapsus",
  "version": "0.1.0",
  "description": "Lapsus - a focused browser for the AMA Discipulus student portal",
  "author": "KRLBRYN",
  "license": "UNLICENSED",
  "private": true,
  "homepage": "https://github.com/kerlbryandomingo-wq/lapsus",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test && node tests/e2e/raw/visibility.mjs",
    "icons": "python3 -I scripts/make-icons.py",
    "package:win": "npm run build && electron-builder --win --x64 --publish never",
    "package:dir": "npm run build && electron-builder --dir --publish never",
    "check:artifacts": "node scripts/check-artifacts.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "lucide-react": "1.61.0",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  }
}
