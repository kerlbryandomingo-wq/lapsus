// Shared build settings for Sophia. Signing values that belong to one developer account live in
// Config/Signing.local.xcconfig, which is git-ignored. Copy Signing.local.xcconfig.example to create it.
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
PRODUCT_BUNDLE_IDENTIFIER = com.krlbryn.sophia
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic

#include? "Signing.local.xcconfig"
